# Copy to .env on the server (.env is gitignored -- never commit it).
#   cp .env.example .env && vim .env

### Required for exporting weights out of Tinker ###
TINKER_API_KEY=

### Required only for gated base models (e.g. meta-llama/*) ###
HF_TOKEN=

### Optional: only needed if you must GENERATE degree-of-belief eval questions
### instead of downloading the paper's. gen_dob_evals.py reads OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

### Paths (normally set by /workspace/env.sh, listed here for reference) ###
# SSF_ROOT=/workspace/science-synth-facts
# SSF_DATA_ROOT=/workspace/data
# SSF_ACTS_ROOT=/workspace/data/activations
# SSF_OUT_ROOT=/workspace/science-synth-facts/outputs
# SSF_MODEL_ROOT=/workspace/models
